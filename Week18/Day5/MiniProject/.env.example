# ---------- LLM backend (OpenAI-compatible API) ----------
# "groq" (GroqCloud, hosted) or "ollama" (local)
LLM_BACKEND=ollama

# GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama: install from https://ollama.com, then `ollama pull qwen2.5:3b` (any tool-calling model works)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ---------- MCP servers (all started locally over STDIO) ----------
# Folder the filesystem server is sandboxed to (briefs are written here)
WORKSPACE_DIR=./workspace
# Third-party server launch commands (override to pin versions or use local installs)
ARXIV_SERVER_CMD=uvx arxiv-mcp-server --storage-path ./workspace/papers
FILESYSTEM_SERVER_CMD=npx -y @modelcontextprotocol/server-filesystem ./workspace
FETCH_SERVER_CMD=uvx mcp-server-fetch
ENABLE_FETCH=1

# ---------- Orchestration ----------
MAX_STEPS=12
TOOL_TIMEOUT_S=90
TOOL_RETRIES=2
LOG_DIR=./logs
